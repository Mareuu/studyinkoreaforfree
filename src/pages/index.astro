---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Fetch and sort all Markdown articles from src/content/blog/
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 2rem;
				list-style-type: none;
				padding: 0;
				margin: 2rem 0;
			}
			.post-card {
				border-radius: 12px;
				overflow: hidden;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				background: var(--accent-light, #f9f9f9);
			}
			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 8px 20px rgba(0,0,0,0.08);
			}
			.post-card a {
				text-decoration: none;
				color: inherit;
				display: block;
			}
			.post-card img {
				width: 100%;
				height: 180px;
				object-fit: cover;
				border-bottom: 1px solid #eee;
			}
			.card-content {
				padding: 1.25rem;
			}
			.card-title {
				margin: 0.5rem 0;
				font-size: 1.25rem;
				line-height: 1.3;
				color: #111;
			}
			.card-date {
				font-size: 0.85rem;
				color: #666;
			}
			.hero-section {
				text-align: center;
				padding: 2rem 0 1rem 0;
			}
			.cta-buttons {
				display: flex;
				gap: 1rem;
				justify-content: center;
				margin-top: 1.5rem;
			}
			.btn {
				padding: 0.75rem 1.5rem;
				border-radius: 8px;
				font-weight: bold;
				text-decoration: none;
			}
			.primary-btn {
				background: #2337ff;
				color: white;
			}
			.secondary-btn {
				border: 2px solid #2337ff;
				color: #2337ff;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Header -->
			<section class="hero-section">
				<h1>Study in South Korea for Free</h1>
				<p>Your complete guide to direct 100% tuition waivers, professor lab stipends, and research assistantships.</p>
				<div class="cta-buttons">
					<a href="/roadmap" class="btn primary-btn">Application Roadmap →</a>
					<a href="/universities" class="btn secondary-btn">Universities</a>
				</div>
			</section>

			<hr />

			<!-- Image Card Feed -->
			<section>
				<h2>Latest Posts & Guides</h2>
				<ul class="post-grid">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.slug}/`}>
									{post.data.heroImage && (
										<Image 
											src={post.data.heroImage} 
											alt={post.data.title}
											width={720}
											height={360}
										/>
									)}
									<div class="card-content">
										<p class="card-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3 class="card-title">{post.data.title}</h3>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>